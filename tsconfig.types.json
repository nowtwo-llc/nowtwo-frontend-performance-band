// Declaration-only build. esbuild-loader strips types without ever emitting
// declarations, so `tsc` produces them once from here into dist/types.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist/types",
        "rootDir": "./src"
    },
    // Only the public module: src/bundle.ts exists purely to pull the
    // stylesheet into the webpack graph and must not reach the declarations.
    "include": ["./src/PerformanceBandEditor.ts"]
}
